\ProvidesPackage{oeneye-font}
\RequirePackage{fontspec}

\setmainfont{OMQ}[
  Path =./,
  Extension =.ttf,
  UprightFont = *,
  BoldFont = *,
  ItalicFont = *,
  BoldItalicFont = *,
  Scale = MatchLowercase,
  Ligatures = {Common, TeX},
  BoldFeatures = {FakeBold=1.2},
  ItalicFeatures = {FakeSlant=0.2}
]

\newfontfamily\oeneyefont{OMQ}[
  Path =./,
  Extension =.ttf,
  UprightFont = *,
  BoldFont = *,
  ItalicFont = *,
  BoldItalicFont = *,
  Scale = MatchLowercase,
  Ligatures = {Common, TeX},
  BoldFeatures = {FakeBold=1.2}
]

\newcommand{\textoeneye}[1]{{\oeneyefont #1}}

\endinput
